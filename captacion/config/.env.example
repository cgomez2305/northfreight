# NorthStar captacion (mini-CRM). Copia este archivo a captacion/config/.env EN EL SERVIDOR y rellena los valores. NUNCA se versiona el .env real.
# Permisos recomendados: chmod 600 captacion/config/.env

# --- Aplicacion ---
# production | local  (local solo para pruebas por http: quita el flag Secure de la cookie de sesion)
APP_ENV=production
# 64 caracteres hexadecimales (32 bytes). Cifra el secreto TOTP y firma los codigos de recuperacion. Genera uno:  php -r "echo bin2hex(random_bytes(32));"
# Si lo cambias, hay que volver a dar de alta el 2FA del administrador. Guarda una copia aparte.
APP_KEY=
# URL del panel, sin barra final (se usa en los enlaces de las alertas)
APP_URL=https://captacion.northstarfreightsolutions.us
# Alta del primer administrador (public/setup.php). 64 hex aleatorios:  php -r "echo bin2hex(random_bytes(32));"   (si queda vacio, setup.php responde 404)
SETUP_TOKEN=
# Token Bearer de /api/lead.php (n8n, carga manual). Minimo 32 caracteres. Vacio = la API responde 503.
INTERNAL_API_TOKEN=

# --- Base de datos (MySQL 8 / MariaDB 10.11 de Hostinger: host 127.0.0.1, puerto 3306) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# --- FMCSA QCMobile (webKey gratuita: https://mobile.fmcsa.dot.gov/QCDevsite/HomePage). Sin ella el lead entra igual y se reintenta (fmcsa_pending) ---
FMCSA_WEBKEY=

# --- Telegram (alertas A2/A3 a Carlos): crea un bot con @BotFather y obten el chat id escribiendole al bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Correo de avisos (email_notify). Mismos nombres que app/config.local.php del sitio. Sin SMTP los avisos quedan en storage/mail.log ---
MAIL_TO=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=ssl

# --- Opcionales (valores por defecto entre parentesis) ---
# SESSION_IDLE_SECONDS=28800       (expiracion por inactividad: 8 h)
# API_RATE_LIMIT=120               (peticiones por hora y por IP a /api/lead.php)
# INGEST_RATE_LIMIT=5              (envios por hora y por IP desde el formulario web)
# JOBS_MAX_SECONDS=50              (tiempo maximo de cada pasada del cron)
# TOTP_ISSUER=NorthStar Captacion
