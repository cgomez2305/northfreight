# NorthStar captacion (mini-CRM). Copia este archivo a captacion/config/.env EN EL SERVIDOR y rellena los valores. NUNCA se versiona el .env real.
# Permisos recomendados: chmod 600 captacion/config/.env

# --- Aplicacion ---
# production | local  (local solo para pruebas por http: quita el flag Secure de la cookie de sesion)
APP_ENV=production
# 64 caracteres hexadecimales (32 bytes). Cifra el secreto TOTP y firma los codigos de recuperacion. Genera uno:  php -r "echo bin2hex(random_bytes(32));"
# Si lo cambias, hay que volver a dar de alta el 2FA del administrador. Guarda una copia aparte.
APP_KEY=
# URL del panel, sin barra final (se usa en los enlaces de las alertas)
APP_URL=https://captacion.northstarfreightsolutions.us
# Alta del primer administrador (public/setup.php). 64 hex aleatorios:  php -r "echo bin2hex(random_bytes(32));"   (si queda vacio, setup.php responde 404)
SETUP_TOKEN=
# Token Bearer de /api/lead.php (n8n, carga manual). Minimo 32 caracteres. Vacio = la API responde 503.
INTERNAL_API_TOKEN=

# --- Base de datos (MySQL 8 / MariaDB 10.11 de Hostinger: host 127.0.0.1, puerto 3306) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# --- FMCSA QCMobile (webKey gratuita: https://mobile.fmcsa.dot.gov/QCDevsite/HomePage). Sin ella el lead entra igual y se reintenta (fmcsa_pending) ---
FMCSA_WEBKEY=

# --- Telegram (alertas A2/A3 a Carlos): crea un bot con @BotFather y obten el chat id escribiendole al bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Correo de avisos (email_notify). Mismos nombres que app/config.local.php del sitio. Sin SMTP los avisos quedan en storage/mail.log ---
MAIL_TO=
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=ssl

# --- Opcionales (valores por defecto entre parentesis) ---
# SESSION_IDLE_SECONDS=28800       (expiracion por inactividad: 8 h)
# API_RATE_LIMIT=120               (peticiones por hora y por IP a /api/lead.php)
# INGEST_RATE_LIMIT=5              (envios por hora y por IP desde el formulario web)
# JOBS_MAX_SECONDS=50              (tiempo maximo de cada pasada del cron)
# TOTP_ISSUER=NorthStar Captacion

# --- Q4a: prospectos FMCSA, referidos y vacantes ---
# Token de aplicacion de data.transportation.gov (opcional, gratis: sube el limite de consultas de la corrida diaria de prospectos)
SOCRATA_APP_TOKEN=
# URL publica del sitio (enlaces de referido: SITE_URL/careers/?ref=CODIGO)
# SITE_URL=https://northstarfreightsolutions.us
# Carpeta storage/ del SITIO donde el panel escribe jobs.json (por defecto <repo>/storage; en Hostinger: public_html/storage)
# SITE_STORAGE_DIR=
# FMCSA_MAX_SECONDS=40             (tiempo maximo de cada pasada de cron/fmcsa_daily.php)
# FMCSA_PAGE_SIZE=200              (filas por pagina de Socrata)

# --- Q4b: canales externos. Cada uno se activa solo si sus variables existen; sin ellas el webhook responde 503 y el panel lo muestra «Sin configurar» ---
# Meta Lead Ads (webhook: /api/webhooks/meta.php). El verify token lo inventas tu (>= 8 caracteres) y lo pegas tambien en Meta
META_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_TOKEN=
# META_GRAPH_VERSION=              (opcional, p. ej. v21.0; vacio = sin version en la URL; ajustar a la vigente)
# Cal.com (webhook: /api/webhooks/calcom.php): el secreto que escribes al crear el webhook en Cal.com
CALCOM_WEBHOOK_SECRET=
# Twilio (webhook: /api/webhooks/sms.php). TWILIO_SID y TWILIO_FROM quedan reservadas para enviar SMS (hoy el CRM no envia)
TWILIO_TOKEN=
# TWILIO_SID=
# TWILIO_FROM=
# TWILIO_WEBHOOK_URL=              (solo si Twilio firma una URL distinta de APP_URL + /api/webhooks/sms.php)
# n8n: firma HMAC de /api/webhooks/n8n.php. Las rutas /internal/* usan INTERNAL_API_TOKEN
N8N_WEBHOOK_SECRET=
# WEBHOOK_RATE_LIMIT=1200          (peticiones por hora y por IP a cada webhook)
# WEBHOOK_MAX_BODY=131072          (bytes)
# WEBHOOK_SIG_FAILS=15             (firmas malas por IP cada 15 min antes de bloquear)
# INTERNAL_RATE_LIMIT=1500         (peticiones por hora y por IP a /internal/*)

# --- Fase O (endurecimiento) ---
# IP real detras de un proxy/CDN: por defecto se usa REMOTE_ADDR. Si en el servidor REMOTE_ADDR llega con la IP del proxy, indica la cabecera que el proxy SOBRESCRIBE con la IP del visitante
# (p. ej. HTTP_X_FORWARDED_FOR o HTTP_CF_CONNECTING_IP; se usa el primer valor que sea una IP valida). COMPRUEBALO en el servidor real antes de activarlo.
# TRUSTED_PROXY_HEADER=
# Vida maxima de una sesion aunque haya actividad (segundos; por defecto 86400 = 24 h). La inactividad sigue caducando a las 8 h (SESSION_IDLE_SECONDS).
# SESSION_ABSOLUTE_SECONDS=86400
