# Buzón de correo del CRM (plantilla). En el servidor se copia como captacion/config/mail.env (fuera de git, carpeta denegada en la web).
# Solo se leen SMTP_*, IMAP_* (fase AT, opcional), MAIL_TO, MAIL_FROM y PHPMAILER_AUTOLOAD, y GANAN al .env.
# Si se cambia la contraseña del buzón en hPanel, hay que cambiarla aquí y en app/config.mail.php.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=contact@northstarfreightsolutions.us
SMTP_PASS="CHANGE-ME"
MAIL_TO=contact@northstarfreightsolutions.us
# Lectura de respuestas a las campañas (opcional): sin estas líneas se usan el usuario y la contraseña del SMTP con imap.hostinger.com:993.
# IMAP_HOST=imap.hostinger.com
# IMAP_PORT=993
# IMAP_SECURE=ssl
