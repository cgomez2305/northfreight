# Buzón de correo del CRM (plantilla). En el servidor se copia como captacion/config/mail.env (fuera de git, carpeta denegada en la web).
# Solo se leen SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE, MAIL_TO, MAIL_FROM y PHPMAILER_AUTOLOAD, y GANAN al .env.
# Si se cambia la contraseña del buzón en hPanel, hay que cambiarla aquí y en app/config.mail.php.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=contact@northstarfreightsolutions.us
SMTP_PASS="CHANGE-ME"
MAIL_TO=contact@northstarfreightsolutions.us
