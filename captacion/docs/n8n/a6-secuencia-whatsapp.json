{
  "name": "NorthStar · A6/A12 Pasos de secuencia por WhatsApp",
  "nodes": [
    {
      "parameters": {
        "content": "NO PROBADO EN UNA INSTANCIA REAL DE N8N. Flujo de NorthStar Captación.\n\nA6/A12: cada 5 minutos pregunta qué paso de secuencia toca por WhatsApp (solo los pasos habilitados en Configuración > Canales externos y solo con consentimiento). Plantillas: ns_a6_d1, ns_a6_d3 (con enlace de la calculadora), ns_a6_d7, ns_a6_d14 y ns_a12_referral, cada una en _en y _es. El correo de las secuencias lo envía el CRM por su cuenta; este flujo solo es el canal de WhatsApp.",
        "height": 260,
        "width": 520
      },
      "id": "f3729077-7b96-2e7f-275b-df945a7513ea",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "f6f4cedc-96c1-2bda-021c-bcd79ae1eaf4",
      "name": "Cada 5 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "crm_base_url",
              "value": "https://captacion.northstarfreightsolutions.us",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "wa_phone_number_id",
              "value": "REEMPLAZAR_PHONE_NUMBER_ID",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "graph_version",
              "value": "v21.0",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "a7b550cb-c673-f2bb-2257-d60c6cd9f647",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.crm_base_url }}/internal/sequences/due?channel=whatsapp&limit=20",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "90754bbc-28a3-f85f-e21e-0f1bf2dfc907",
      "name": "Pedir al CRM quién toca",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_CRM",
          "name": "Captacion CRM (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "cb8a405f-7c7e-5f54-88e6-b12961d6d14c",
      "name": "Un item por lead",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ ['a6_warm', 'a12_referral'].includes($('Un item por lead').item.json.sequence) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ff2a81d2-f5d6-5c31-b935-ae492740c85a",
      "name": "Solo este paso",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('Config').first().json.graph_version }}/{{ $('Config').first().json.wa_phone_number_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: String($json.to).replace('+',''), type: 'template', template: { name: 'ns_' + $('Un item por lead').item.json.template + '_' + $('Un item por lead').item.json.language, language: { code: $json.language === 'es' ? 'es' : 'en_US' }, components: [{ type: 'body', parameters: $('Un item por lead').item.json.template === 'a6_d3' ? [{ type: 'text', text: $('Un item por lead').item.json.vars.nombre }, { type: 'text', text: $('Un item por lead').item.json.vars.link_calculadora }] : [{ type: 'text', text: $('Un item por lead').item.json.vars.nombre }] }] } }) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "246f6dff-844b-b488-b25e-3a0c5b3a5e2b",
      "name": "Enviar plantilla por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_WHATSAPP",
          "name": "WhatsApp Cloud API (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "k1",
              "leftValue": "={{ $json.messages && $json.messages[0] && $json.messages[0].id ? $json.messages[0].id : \"\" }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "aef5f434-00ec-d9bf-c3cb-ca6a4444d1d8",
      "name": "¿WhatsApp aceptó el mensaje?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        -60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.crm_base_url }}/internal/leads/{{ $('Un item por lead').item.json.lead_id }}/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'sequence_step_sent', channel: 'whatsapp', sequence: $('Un item por lead').item.json.sequence, step: $('Un item por lead').item.json.step, message_id: $json.messages[0].id, event_id: 'seq-' + $('Un item por lead').item.json.lead_id + '-' + $('Un item por lead').item.json.sequence + '-' + $('Un item por lead').item.json.step }) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "31655f35-e641-f218-f1b2-f45a7f40c92a",
      "name": "Avisar al CRM: enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -140
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_CRM",
          "name": "Captacion CRM (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.crm_base_url }}/internal/leads/{{ $('Un item por lead').item.json.lead_id }}/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'message_failed', channel: 'whatsapp', template: 'seq', error: JSON.stringify(($json.error && $json.error.message) || 'sin detalle').slice(0, 150), event_id: 'seqf-' + $('Un item por lead').item.json.lead_id + '-' + $execution.id }) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "e0323653-f262-4d3b-fb2b-1a2a630aecd3",
      "name": "Avisar al CRM: falló",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        40
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_CRM",
          "name": "Captacion CRM (Bearer)"
        }
      }
    }
  ],
