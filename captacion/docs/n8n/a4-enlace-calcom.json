{
  "name": "NorthStar · A4 Enlace de Cal.com al pasar a Calificado",
  "nodes": [
    {
      "parameters": {
        "content": "NO PROBADO EN UNA INSTANCIA REAL DE N8N. Flujo de NorthStar Captación.\n\nA4: cuando Carlos pasa un lead a Calificado, el CRM lo ofrece en /internal/sequences/due (si \"a4_booking\" está habilitado y hay un enlace de reserva en Configuración > Canales externos). Este flujo manda el enlace de Cal.com con la plantilla ns_a4_booking_en / _es. El correo con el mismo enlace NO está en este flujo (queda pendiente de decidir).",
        "height": 260,
        "width": 520
      },
      "id": "5c23b579-2e7d-5786-8aa3-4a070ffe46c4",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "c1307afc-c58d-1285-1a5a-107e35d39fdd",
      "name": "Cada 2 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "crm_base_url",
              "value": "https://captacion.northstarfreightsolutions.us",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "wa_phone_number_id",
              "value": "REEMPLAZAR_PHONE_NUMBER_ID",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "graph_version",
              "value": "v21.0",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "139052d4-a550-8991-948d-7de44bef27d1",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.crm_base_url }}/internal/sequences/due?channel=whatsapp&limit=20",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "0eb5bbb9-d6ce-50e2-9ab8-5a6c84d0b50d",
      "name": "Pedir al CRM quién toca",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_CRM",
          "name": "Captacion CRM (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "ba62b5cf-913b-b15d-bc8b-a4dcbc68e47f",
      "name": "Un item por lead",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $('Un item por lead').item.json.sequence === 'a4_booking' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "94f9c126-e3ab-e7c4-f78d-a1d9b974ce25",
      "name": "Solo este paso",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('Config').first().json.graph_version }}/{{ $('Config').first().json.wa_phone_number_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: String($json.to).replace('+',''), type: 'template', template: { name: 'ns_a4_booking_' + $('Un item por lead').item.json.language, language: { code: $json.language === 'es' ? 'es' : 'en_US' }, components: [{ type: 'body', parameters: [{ type: 'text', text: $('Un item por lead').item.json.vars.nombre }, { type: 'text', text: $('Un item por lead').item.json.vars.booking_url }] }] } }) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "8dd5aa78-6421-67b0-4afe-e81aec316d23",
      "name": "Enviar plantilla por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_WHATSAPP",
          "name": "WhatsApp Cloud API (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "k1",
              "leftValue": "={{ $json.messages && $json.messages[0] && $json.messages[0].id ? $json.messages[0].id : \"\" }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "89a1d3f4-e27d-03dc-a1fe-62aea639d60b",
      "name": "¿WhatsApp aceptó el mensaje?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        -60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.crm_base_url }}/internal/leads/{{ $('Un item por lead').item.json.lead_id }}/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'message_sent', channel: 'whatsapp', template: 'a4_booking', message_id: $json.messages[0].id, event_id: 'a4-' + $('Un item por lead').item.json.lead_id }) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "49a1aa18-4832-8db2-b5cc-190ebff92b2a",
      "name": "Avisar al CRM: enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -140
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_CRM",
          "name": "Captacion CRM (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.crm_base_url }}/internal/leads/{{ $('Un item por lead').item.json.lead_id }}/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'message_failed', channel: 'whatsapp', template: 'a4_booking', error: JSON.stringify(($json.error && $json.error.message) || 'sin detalle').slice(0, 150), event_id: 'a4f-' + $('Un item por lead').item.json.lead_id + '-' + $execution.id }) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "8aa5427c-c8f1-afa6-c84e-170ff56027bc",
      "name": "Avisar al CRM: falló",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        40
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_CRM",
          "name": "Captacion CRM (Bearer)"
        }
      }
    }
