{
  "name": "NorthStar · A1 Bienvenida por WhatsApp",
  "nodes": [
    {
      "parameters": {
        "content": "NO PROBADO EN UNA INSTANCIA REAL DE N8N. Flujo de NorthStar Captación.\n\nA1: cada 2 minutos pregunta al CRM qué leads nuevos pueden recibir la bienvenida por WhatsApp (solo con consentimiento vigente en ese canal, solo leads de los últimos 3 días y solo si \"a1_welcome\" está habilitado en Configuración > Canales externos). Envía la plantilla aprobada ns_a1_welcome_en / ns_a1_welcome_es (ver whatsapp-templates.md) y le dice al CRM que se envió.",
        "height": 260,
        "width": 520
      },
      "id": "90d0c71c-ea83-0127-fc25-2fe20c60c65e",
      "name": "Nota",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -260
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 2
            }
          ]
        }
      },
      "id": "10c05ae9-87f0-363d-ee2d-9381a8f8ef7c",
      "name": "Cada 2 minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "crm_base_url",
              "value": "https://captacion.northstarfreightsolutions.us",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "wa_phone_number_id",
              "value": "REEMPLAZAR_PHONE_NUMBER_ID",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "graph_version",
              "value": "v21.0",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "ab5a9a86-e0b8-2ee4-949e-bbe112d9dde5",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Config').first().json.crm_base_url }}/internal/sequences/due?channel=whatsapp&limit=20",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 15000
        }
      },
      "id": "409df5f1-82d7-de73-fdc3-a10f0febd5cf",
      "name": "Pedir al CRM quién toca",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_CRM",
          "name": "Captacion CRM (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "fieldToSplitOut": "items",
        "options": {}
      },
      "id": "89832c19-70ab-a090-1b8f-c7d097162cc6",
      "name": "Un item por lead",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "f1",
              "leftValue": "={{ $('Un item por lead').item.json.sequence === 'a1_welcome' }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "932bedc3-c0cf-97ae-b11c-b8dc4827cb76",
      "name": "Solo este paso",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('Config').first().json.graph_version }}/{{ $('Config').first().json.wa_phone_number_id }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: String($json.to).replace('+',''), type: 'template', template: { name: 'ns_a1_welcome_' + $('Un item por lead').item.json.language, language: { code: $json.language === 'es' ? 'es' : 'en_US' }, components: [{ type: 'body', parameters: [{ type: 'text', text: $('Un item por lead').item.json.vars.nombre }] }] } }) }}",
        "options": {
          "timeout": 20000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "763fbf98-4ca1-e0bc-d9c4-e1de077347b5",
      "name": "Enviar plantilla por WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -60
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_WHATSAPP",
          "name": "WhatsApp Cloud API (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "k1",
              "leftValue": "={{ $json.messages && $json.messages[0] && $json.messages[0].id ? $json.messages[0].id : \"\" }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "0b476b62-2e9f-4ad5-dd18-da3619522707",
      "name": "¿WhatsApp aceptó el mensaje?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1320,
        -60
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.crm_base_url }}/internal/leads/{{ $('Un item por lead').item.json.lead_id }}/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'message_sent', channel: 'whatsapp', template: 'a1_welcome', message_id: $json.messages[0].id, event_id: 'a1-' + $('Un item por lead').item.json.lead_id }) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "55d45bd4-355a-7c2b-b8e0-b6dd7cd42829",
      "name": "Avisar al CRM: enviado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        -140
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_CRM",
          "name": "Captacion CRM (Bearer)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.crm_base_url }}/internal/leads/{{ $('Un item por lead').item.json.lead_id }}/events",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ event: 'message_failed', channel: 'whatsapp', template: 'a1_welcome', error: JSON.stringify(($json.error && $json.error.message) || 'sin detalle').slice(0, 150), event_id: 'a1f-' + $('Un item por lead').item.json.lead_id + '-' + $execution.id }) }}",
        "options": {
          "timeout": 15000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "00e00ecf-e3c2-0416-b634-48f4406f7958",
      "name": "Avisar al CRM: falló",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        40
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR_CREDENCIAL_CRM",
          "name": "Captacion CRM (Bearer)"
        }
      }
    }
  ],
