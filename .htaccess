# =====================================================================
# NorthStar Freight Solutions — .htaccess (Hostinger / LiteSpeed / Apache)
# Orden: (www) + HTTPS -> bloqueos -> barra final -> front controller
# =====================================================================

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# ---- 1) Dominio ÚNICO sin www + HTTPS forzado (fase AF) -------------
# Dominio definitivo: northstarfreightsolutions.us SIN www (el canonical y el sitemap ya usan el apex).
# www -> apex en UN solo salto (antes servía 200 en www con el mismo contenido).
# Si el dominio cambia: sustituir aquí y fijar DOMAIN en app/config.local.php.
RewriteCond %{HTTP_HOST} ^www\.northstarfreightsolutions\.us$ [NC]
RewriteRule ^ https://northstarfreightsolutions.us%{REQUEST_URI} [L,R=301]

# HTTPS forzado (se omite en localhost para poder probar)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- 2b) "//ruta/" -> "/ruta/" (301, sin URLs duplicadas; index.php hace lo mismo como respaldo) ----
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s[^\s?]*//
RewriteRule ^/*(.*)$ /$1 [R=301,L,NE]

# ---- 3) Bloquear acceso web a código, datos y secretos --------------
# Directorios internos (también los bloquea index.php en php -S).
RewriteRule ^(app|templates|storage|vendor|bin|node_modules|\.git|\.claude)(/|$) - [F,L]
# Mini-CRM de captacion (captacion/ y su carpeta cron/): NADA de ese codigo se sirve por el dominio principal. El panel vive en el subdominio captacion.,
# cuya raiz debe ser captacion/public/ (ver captacion/README.md); el subdominio tiene su propio .htaccess y no pasa por esta regla (condicion de host).
RewriteCond %{HTTP_HOST} !^captacion\. [NC]
RewriteRule ^(captacion|cron)(/|$) - [F,L,NC]
# Las plantillas descargables (assets/downloads/) solo se entregan desde el formulario (app/forms/download.php): la URL directa devuelve 403.
RewriteRule ^assets/downloads(/|$) - [F,L]
# Archivos sueltos: composer.*, configuración local, markdown, dotfiles (menos .well-known).
RewriteRule ^composer\.(json|lock)$ - [F,L]
RewriteRule (^|/)config\.local(\.example)?\.php$ - [F,L]
RewriteRule \.md$ - [F,L,NC]
RewriteRule (^|/)\.(?!well-known) - [F,L]
# Ningún .php se ejecuta salvo el front controller.
RewriteRule ^(?!index\.php$).+\.php$ - [F,L,NC]

# ---- 4) Barra final (301) en URLs sin extensión, solo GET/HEAD -------
# POST /contact (sin barra) lo gestiona index.php con 308.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,6}$
RewriteRule ^(.+[^/])$ https://%{HTTP_HOST}/$1/ [L,R=301]

# ---- 5) Todo lo que no sea archivo real -> front controller ---------
# /favicon.ico: los navegadores lo piden siempre; se sirve el .ico de assets/img (respaldo: index.php).
RewriteRule ^favicon\.ico$ assets/img/favicon.ico [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>

# 404 lo renderiza index.php (con status 404 correcto)
ErrorDocument 404 /index.php

# Refuerzo si mod_rewrite no estuviera activo: denegar archivos sensibles.
<FilesMatch "(^composer\.(json|lock)$|^config\.local.*\.php$|\.md$|^\.git|^\.htaccess$|^\.gitignore$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---- 6) Compresión ----------------------------------------------------
# Texto comprimible: HTML, CSS, JS (los dos tipos MIME), JSON (+ JSON-LD), XML, texto plano y SVG. NO se comprimen imágenes raster, woff2, mp4 ni webm (ya vienen comprimidos).
# LiteSpeed (Hostinger) usa su propia compresión del servidor; estas directivas cubren Apache y sirven de documentación de los tipos esperados.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/xml application/javascript application/x-javascript application/json application/ld+json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/xml application/javascript application/x-javascript application/json application/ld+json image/svg+xml font/ttf
</IfModule>

# ---- 7) Caché y cabeceras ---------------------------------------------
# Assets (CSS/JS/fuentes/imágenes/video): 1 año; el ?v=filemtime de asset() invalida al cambiar. Los mp4 de assets/video/ son archivos reales (no pasan por index.php):
# Apache/LiteSpeed los sirven con Accept-Ranges: bytes y Content-Type video/mp4 (moov al inicio, sin compresión). Comprobar en staging con: curl -sI -H 'Range: bytes=0-99' <url>.mp4 (206).
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # HTML: corto (index.php fija además su propio Cache-Control)
    ExpiresByType text/html "access plus 5 minutes"
</IfModule>
# Los CSS minificados del build (assets/css/dist/*.css, ver bin/build-assets.php) entran en la misma regla de 1 año: su ?v= es un hash del contenido, así que cambia solo cuando cambia el archivo.
# Las fuentes se enlazan sin ?v= (desde el CSS y el preload): si se sustituye un woff2, darle un nombre nuevo.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|webp|avif|jpe?g|png|svg|ico|mp4|webm)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    # Los tipos que se comprimen varían según Accept-Encoding: las cachés intermedias deben distinguirlos.
    <FilesMatch "\.(css|js|svg|json|xml|txt)$">
        Header append Vary "Accept-Encoding"
    </FilesMatch>
    # Video: rangos de bytes (el navegador pide trozos con Range y recibe 206; sin esto no se puede saltar ni reanudar).
    <FilesMatch "\.(mp4|webm)$">
        Header set Accept-Ranges "bytes"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
    # Seguridad (fase O). Las páginas HTML pasan por index.php, que emite las mismas y añade la CSP Report-Only con los hashes de sus scripts inline (por eso la CSP NO se fija aquí).
    # HSTS un año con includeSubDomains (sin "preload" todavía). Solo por HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
    Header always unset X-Powered-By
    Header unset X-Powered-By
</IfModule>
AddType font/woff2 .woff2
AddType video/mp4 .mp4
AddType video/webm .webm
AddType image/webp .webp
AddType image/avif .avif
