# =====================================================================
# NorthStar Freight Solutions — .htaccess (Hostinger / LiteSpeed / Apache)
# Orden: HTTPS -> (www) -> bloqueos -> barra final -> front controller
# =====================================================================

Options -Indexes -MultiViews
ServerSignature Off
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# ---- 1) HTTPS forzado (se omite en localhost para poder probar) -----
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ---- 2) Dominio ÚNICO (www o no-www; el cliente decide) -------------
# Dominio definitivo PENDIENTE. Al decidirlo:
#   a) fija DOMAIN en app/config.local.php (sin www si eliges no-www);
#   b) descomenta SOLO UNA de las dos reglas y sustituye "example.com".
#
# Opción A — forzar SIN www:
# RewriteCond %{HTTP_HOST} ^www\.example\.com$ [NC]
# RewriteRule ^ https://example.com%{REQUEST_URI} [L,R=301]
#
# Opción B — forzar CON www:
# RewriteCond %{HTTP_HOST} ^example\.com$ [NC]
# RewriteRule ^ https://www.example.com%{REQUEST_URI} [L,R=301]

# ---- 3) Bloquear acceso web a código, datos y secretos --------------
# Directorios internos (también los bloquea index.php en php -S).
RewriteRule ^(app|templates|storage|vendor|bin|node_modules|\.git|\.claude)(/|$) - [F,L]
# Archivos sueltos: composer.*, configuración local, markdown, dotfiles (menos .well-known).
RewriteRule ^composer\.(json|lock)$ - [F,L]
RewriteRule (^|/)config\.local(\.example)?\.php$ - [F,L]
RewriteRule \.md$ - [F,L,NC]
RewriteRule (^|/)\.(?!well-known) - [F,L]
# Ningún .php se ejecuta salvo el front controller.
RewriteRule ^(?!index\.php$).+\.php$ - [F,L,NC]

# ---- 4) Barra final (301) en URLs sin extensión, solo GET/HEAD -------
# POST /contact (sin barra) lo gestiona index.php con 308.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.[A-Za-z0-9]{1,6}$
RewriteRule ^(.+[^/])$ https://%{HTTP_HOST}/$1/ [L,R=301]

# ---- 5) Todo lo que no sea archivo real -> front controller ---------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>

# 404 lo renderiza index.php (con status 404 correcto)
ErrorDocument 404 /index.php

# Refuerzo si mod_rewrite no estuviera activo: denegar archivos sensibles.
<FilesMatch "(^composer\.(json|lock)$|^config\.local.*\.php$|\.md$|^\.git|^\.htaccess$|^\.gitignore$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---- 6) Compresión ----------------------------------------------------
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml font/ttf
</IfModule>

# ---- 7) Caché y cabeceras ---------------------------------------------
# Assets (CSS/JS/fuentes/imágenes): 1 año; el ?v=filemtime de asset() invalida al cambiar.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    # HTML: corto (index.php fija además su propio Cache-Control)
    ExpiresByType text/html "access plus 5 minutes"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|webp|avif|jpe?g|png|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>
AddType font/woff2 .woff2
AddType image/webp .webp
AddType image/avif .avif
