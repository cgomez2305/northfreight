# Dependencias (se instalan con `composer install` en el servidor)
/vendor/

# Storage: logs y rate-limit del formulario; solo se versionan estos dos archivos
/storage/*
!/storage/.htaccess
!/storage/.gitkeep
# (cubiertos por /storage/*, explícitos por claridad)
/storage/ratelimit/
/storage/*.log
/storage/*.log.1
/storage/app.key

# Configuración local con credenciales (usar app/config.local.example.php como plantilla)
/app/config.local.php

# Sistema / editores
.DS_Store
node_modules/

# Mini-CRM de captacion: el .env real, logs, sesiones, locks y rate-limit viven solo en el servidor
/captacion/config/.env
/captacion/storage/*
!/captacion/storage/.gitignore
!/captacion/storage/.htaccess
